# Environment variables example file
DEVELOPMENT=true
LOG_JSON_LOGGING=false
LOG_COLORIZE=true
LOG_ADD_CALLER=true
LOG_DISABLE_STACKTRANCE=false
LOG_UNESCAPE_MULTILINE=true
LOG_LEVEL=debug
KEA_URL=https://localhost
# Backups, comma-separated, tried in order once the primary has used up its retries
# (KEA_SECONDARY_URL still works for a single backup)
KEA_SECONDARY_URLS=https://localhost:8001
KEA_PORT=8000
KEA_BASIC_AUTH_USERNAME=
KEA_BASIC_AUTH_PASSWORD=
KEA_TLS_INSECURE=true
KEA_TLS_ENABLED=true
KEA_TLS_CA_FILE=./hack/docker/certs/ca.crt
KEA_TLS_CERT_FILE=./hack/docker/certs/client.crt
KEA_TLS_KEY_FILE=./hack/docker/certs/client.key
KEA_TLS_SERVER_NAME=kea-dhcpv4-server.vitistack.io
KEA_TIMEOUT_SECONDS=60
KEA_CONNECT_TIMEOUT_SECONDS=10
# Primary retries on timeout / connection error / HTTP 502-504, and how long to skip it after a failover
KEA_PRIMARY_RETRIES=3
KEA_RETRY_BACKOFF=1s
KEA_RETRY_MAX_BACKOFF=10s
KEA_PRIMARY_COOLDOWN=30s
KEA_PIN_RESERVATIONS=log
KEA_CLEANUP_TIMEOUT=15m
KEA_HEADER=Content-Type: application/json